{
	"name": "remote-volume",
	"version": "1.2.1",
	"description": "An application for controlling the system volume over a WebSocket connection",
	"main": "main.js",
	"type": "module",
	"displayName": "Remote Volume",
	"keywords": [],
	"scripts": {
		"start": "electron .",
		"prestart": "node scripts/build-win-helper.js",
		"build": "electron-builder",
		"prebuild": "node scripts/build-win-helper.js",
		"build:helper": "node scripts/build-win-helper.js --force",
		"test": "node --test"
	},
	"build": {
		"appId": "com.utsgmbh.volumeremote",
		"productName": "Remote Volume",
		"publish": null,
		"files": [
			"**/*",
			"!test/**",
			"!docs/**",
			"!scripts/**",
			"!impl/windows/*.cs",
			"!CLAUDE.md"
		],
		"asarUnpack": [
			"impl/windows/*.exe"
		],
		"mac": {
			"notarize": false,
			"target": [
				{
					"target": "dmg",
					"arch": [
						"x64",
						"arm64"
					]
				}
			],
			"icon": "icon.png"
		},
		"afterSign": "scripts/notarize.js",
		"win": {
			"target": [
				{
					"target": "zip",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "icon.png",
			"artifactName": "RemoteVolume-${version}-win-${arch}.zip"
		},
		"linux": {
			"target": [
				{
					"target": "deb",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "icon.png",
			"category": "AudioVideo"
		}
	},
	"author": "Ultimate Technology Solutions GmbH <info@ultimate-technology.de>",
	"license": "MIT",
	"dependencies": {
		"electron-auto-launch": "^5.0.7",
		"electron-log": "^5.2.0",
		"electron-store": "^10.0.0",
		"execa": "4.0.3",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@electron/notarize": "^2.5.0",
		"electron": "^33.0.2",
		"electron-builder": "^25.1.8"
	},
	"optionalDependencies": {
		"@capaj/naudiodon": "^2.4.0"
	}
}
